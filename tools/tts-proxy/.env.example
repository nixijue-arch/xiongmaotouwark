# 复制为 .env 后编辑. docker compose 会自动读取.

# 必填: 解析到本机 BWH 公网 IP 的子域名 (Caddy 用它申请 HTTPS 证书)
TTS_DOMAIN=tts.example.com

# 可选: 设了就要求请求带 ?key=xxx 或 Authorization: Bearer xxx (防别人白嫖你的代理).
#   注意: 浏览器端 key 不算真机密(会暴露在请求里), 主要是挡随机扫描. 真要锁死用 ALLOWED_ORIGINS 或 Cloudflare Access.
TTS_API_KEY=

# 可选: 只放行这些来源的浏览器请求 (逗号分隔, 无空格). 强烈建议填上你的站点防滥用.
#   curl 等无 Origin 的请求仍放行(方便健康检查), 浏览器滥用会被挡.
ALLOWED_ORIGINS=https://xiongmaotou.work,http://localhost:3000

# 可选: 单次最大字符数 (默认 300)
MAX_TEXT_LEN=300
